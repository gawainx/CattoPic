# CattoPic deployment configuration
# Fill in this file as .env.local, then run: pnpm config:worker

# Vercel frontend environment variables. Set these after the Worker and R2 domain exist.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_REMOTE_PATTERNS=

# Cloudflare Worker configuration. Wrangler automatically creates R2, D1, and KV bindings on the first deploy.
CATTOPIC_WORKER_NAME=cattopic-worker
# Set this after you bind an R2 custom domain in the Cloudflare dashboard.
CATTOPIC_R2_PUBLIC_URL=

# Keep false unless you have enabled Cloudflare Queues on a paid Workers plan.
CATTOPIC_USE_QUEUE=false
