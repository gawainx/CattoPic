# CattoPic deployment configuration
# Fill in this file as .env.local, then run: pnpm config:worker

# Vercel frontend environment variables. Add these same two values in Vercel.
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_REMOTE_PATTERNS=https://img.example.com

# Cloudflare Worker and R2 configuration. These values generate worker/wrangler.toml.
CATTOPIC_WORKER_NAME=cattopic-worker
CATTOPIC_R2_PUBLIC_URL=https://img.example.com
CATTOPIC_R2_BUCKET_NAME=cattopic-r2
CATTOPIC_D1_DATABASE_NAME=CattoPic-D1
CATTOPIC_D1_DATABASE_ID=replace-with-your-d1-database-id
CATTOPIC_KV_NAMESPACE_ID=replace-with-your-kv-namespace-id

# Keep false unless you have enabled Cloudflare Queues on a paid Workers plan.
CATTOPIC_USE_QUEUE=false
